# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# AI
# .claude is local (settings, personal skills) except the project skills, which are relative
# symlinks into .agents/skills (managed by the `skills` CLI, pinned in skills-lock.json).
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/nuxt
!.claude/skills/pinia
!.claude/skills/pnpm
!.claude/skills/vite
!.claude/skills/vitest
!.claude/skills/vue

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist
dist-seed


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Scraper debug artifacts (local fallback when R2 is not configured)
apps/api/debug-artifacts/

# Database dumps written by the self-host backup service (docker-compose.yml)
backups/
