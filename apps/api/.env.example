# Application
NODE_ENV=development
PORT=3000
# Extra browser origin allowed by CORS (the public URL is already allowed via PUBLIC_URL).
# CORS_ORIGIN=https://app.example.com

# Database
DATABASE_URL="postgresql://badger:badger_password@localhost:5433/badger_db?schema=public"

# Runtime state root: generated secrets (secrets/) and debug artifacts (debug-artifacts/).
# Default ./data in dev; the Docker image sets /data.
# DATA_DIR=./data

# FX rates (freecurrencyapi.com) for multi-currency accounts. Without a key, keep all accounts in one currency:
# the default Cash account is ILS and new accounts default to the browser locale currency.
# FREE_CURRENCY_API_KEY=

# Seed the demo account (demo@demo.demo) on `prisma db seed`. Set in the dev template; production defaults to off.
SEED_DEMO=true

# JWT — leave the three secrets below unset to auto-generate them into DATA_DIR/secrets on first boot.
# JWT_SECRET=
JWT_EXPIRATION=15m
# JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d

# Registration — open until the first non-demo user exists, then new accounts get 403. Set to "true" to keep signup open on an instance that already has users.
# ALLOW_REGISTRATION=

# Google OAuth — Google login is disabled unless both GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Credential encryption — leave unset to auto-generate into DATA_DIR/secrets (changing it later makes stored credentials undecryptable)
# CREDENTIAL_ENCRYPTION_PEPPER=

# Google Sheets service account (read-only). The fields of the service account's JSON key file, copied as-is.
# The Google Sheets UI stays hidden until CLIENT_EMAIL and PRIVATE_KEY are set. Share each sheet with CLIENT_EMAIL.
GOOGLE_SHEETS_TYPE=
GOOGLE_SHEETS_PROJECT_ID=
GOOGLE_SHEETS_PRIVATE_KEY_ID=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_CLIENT_ID=

# Browser / Puppeteer (used by israeli-bank-scrapers)
# Option A: Connect to a remote Browserless service (recommended for production/Docker)
# BROWSERLESS_URL=ws://browserless:3000
# Option B: Launch local Chromium via Puppeteer (default for local dev — leave BROWSERLESS_URL unset)
# In Linux containers without Browserless, add launch args (the production image already sets these,
# plus PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium):
# PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage

# Route Visa Cal scrapes through an Israeli HTTP proxy, with Browserless or local Chromium; Cal only, other banks
# connect directly. Cal's bot protection rejects datacenter IPs. If the proxied attempt fails for a
# non-credential reason, the scrape is retried once directly. Leave unset to disable.
# CAL_PROXY_URL=http://100.x.y.z:8888

# Max concurrent scraper sessions per sync job (default: 3).
# Raise if your Browserless instance supports more concurrent sessions; lower if you hit resource limits.
# BANK_SYNC_CONCURRENCY=3

# Cloudflare R2 — scraper debug artifact storage (PNG screenshots + MHTML snapshots + page HTML on failure).
# These contain bank-page content. When R2 is unset and the flag below is off, nothing is stored.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=your-r2-bucket-name
# R2_PRESIGN_TTL=604800   # Presigned URL TTL in seconds (default 7 days)
# Set to "true" to also write debug artifacts to local disk. Works independently of R2 (set both to upload AND save).
# Written to DEBUG_ARTIFACTS_DIR, else DATA_DIR/debug-artifacts, else ./debug-artifacts.
# STORE_SCRAPER_DEBUG_LOCALLY=true
# DEBUG_ARTIFACTS_DIR=/path/to/debug-artifacts

# --- Transaction attachments (receipts) ---
# S3-compatible bucket: works with R2, AWS S3, MinIO and Backblaze B2. Keep the bucket private (no public ACL). Browsers
# read files through short-lived presigned URLs, so the endpoint must be reachable from users' browsers.
# Attachments stay off unless ENDPOINT, BUCKET, ACCESS_KEY_ID and SECRET_ACCESS_KEY are all set. Path-style addressing is always used.
# ATTACHMENTS_S3_ENDPOINT=https://s3.example.com
# ATTACHMENTS_S3_BUCKET=badger-attachments
# ATTACHMENTS_S3_ACCESS_KEY_ID=
# ATTACHMENTS_S3_SECRET_ACCESS_KEY=
# Signing region. Default auto (right for R2); set the real region for AWS S3 or B2.
# ATTACHMENTS_S3_REGION=auto
# Host the browser uses for signed URLs, when it differs from ENDPOINT. Default: ENDPOINT.
# ATTACHMENTS_S3_PUBLIC_ENDPOINT=https://files.example.com
# Local development stand-in: see apps/api/ARCHITECTURE.md (Attachment storage).

# --- MCP / OAuth ---
# Public URL of the app (no trailing slash): the single-origin setup. The API (OAuth issuer, MCP metadata), the web app
# (OAuth consent page) and CORS all use it. Never derived from request Host headers.
# API_PUBLIC_URL and WEB_APP_URL override it per service. If all unset: http://localhost:$PORT for the API and
# http://localhost:3001 for the web app (the API origin when the web app is bundled, see WEB_DIST_DIR).
# PUBLIC_URL=https://budget.example.com
# API_PUBLIC_URL=https://api.example.com
# WEB_APP_URL=https://app.example.com
# Directory with a built web app (index.html + assets) that this API serves on the same origin. The Docker image sets it.
# WEB_DIST_DIR=/app/web
# Reverse-proxy hops to trust for the client IP (X-Forwarded-For); drives per-IP throttling. Default 1.
# Behind Cloudflare plus another proxy use 2 (or trust CF-Connecting-IP only when origin traffic is restricted to Cloudflare IP ranges).
# TRUST_PROXY_HOPS=1

# --- Update check ---
# Once a day (and at boot) the API asks GitHub for the latest release, for the About card and the new-release banner.
# Set to false for no outbound request at all.
# UPDATE_CHECK=false
# Repository to check for releases (forks). Default: shai-raz/badger-budget
# UPDATE_CHECK_REPO=shai-raz/badger-budget

# --- In-app upgrade (admin only) ---
# Set URL to let an admin upgrade from the update dialog by calling the host's deploy webhook (POST).
# Leave it unset and the upgrade button stays hidden. See the README "Upgrade from the app" section for host recipes.
# DEPLOY_WEBHOOK_URL=https://coolify.example.com/api/v1/deploy?uuid=...
# The URL must not contain credentials (user:pass@); put secrets in DEPLOY_WEBHOOK_TOKEN instead.
# Optional token, sent as "Authorization: Bearer <token>" unless TOKEN_HEADER is set.
# DEPLOY_WEBHOOK_TOKEN=
# Optional header name for the token. Any name other than Authorization gets the raw token, e.g. x-api-key.
# DEPLOY_WEBHOOK_TOKEN_HEADER=
# Optional JSON body sent with the POST, e.g. {"composeId":"..."}.
# DEPLOY_WEBHOOK_BODY=
